{
  "name": "blank-space",
  "type": "module",
  "version": "1.0.0",
  "description": "a minimal blank",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xli33/blank-space.git"
  },
  "author": "Xli33",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Xli33/blank-space/issues"
  },
  "homepage": "https://github.com/Xli33/blank-space#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.95.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1"
  }
}
